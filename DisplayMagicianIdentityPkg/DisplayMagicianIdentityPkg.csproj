<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Suppress compiler/publish noise — this project only runs MSBuild targets -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyBuildOutputToPublishDirectory>false</CopyBuildOutputToPublishDirectory>
  </PropertyGroup>

  <!-- Import local signing config if present (generated by prepare_displaymagician.ps1) -->
  <Import Project="..\SigningConfig.props" Condition="Exists('..\SigningConfig.props')" />

  <PropertyGroup>
    <!-- All paths are relative to this file's directory -->
    <IdentityPkgDir>$(MSBuildThisFileDirectory)</IdentityPkgDir>
    <!-- Output lands directly into DisplayMagicianPackage\Packages\ so the MSI picks it up -->
    <PackagesOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\DisplayMagicianPackage\Packages'))</PackagesOutputDir>
    <IdentityMsixPath>$(PackagesOutputDir)\DisplayMagicianIdentityPkg.msix</IdentityMsixPath>

    <!-- Locate the Windows SDK bin directory via registry (works on any machine) -->
    <WindowsKitRoot>$([MSBuild]::GetRegistryValueFromView(
        'HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots',
        'KitsRoot10',
        null,
        RegistryView.Registry32,
        RegistryView.Default))</WindowsKitRoot>
    <!-- WindowsKitBinDir and tool paths are resolved in the Build target after globbing SDK versions -->
  </PropertyGroup>

  <!-- ─────────────────────────────────────────────────────────────────────── -->
  <!-- Patch the AppxManifest Identity Version to match DisplayMagician.exe  -->
  <Target Name="PatchMsixVersion" BeforeTargets="BuildMsix">
    <PropertyGroup>
      <_DmExePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\DisplayMagician\bin\$(Configuration)\DisplayMagician.exe'))</_DmExePath>
    </PropertyGroup>

    <Warning Condition="!Exists('$(_DmExePath)')"
             Text="DisplayMagician.exe not found — AppxManifest version will not be patched. Build DisplayMagician first." />

    <Exec Condition="Exists('$(_DmExePath)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)PatchMsixVersion.ps1&quot; -ExePath &quot;$(_DmExePath)&quot; -ManifestPath &quot;$(MSBuildThisFileDirectory)AppxManifest.xml&quot;"
          ConsoleToMsBuild="true" />
  </Target>

  <!-- ─────────────────────────────────────────────────────────────────────── -->
  <Target Name="BuildMsix" AfterTargets="Build">

    <!-- Resolve highest installed Windows 10 SDK version via PowerShell -->
    <Exec Command="powershell -NoProfile -Command &quot;(Get-ChildItem '$(WindowsKitRoot)bin' -Filter '10.*' -Directory | Sort-Object Name -Descending | Select-Object -First 1 -ExpandProperty FullName)&quot;"
          ConsoleToMsBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="WindowsKitVersionDir" />
    </Exec>
    <PropertyGroup>
      <WindowsKitBinDir>$(WindowsKitVersionDir.Trim())\x64</WindowsKitBinDir>
      <MakeAppxExe>$(WindowsKitBinDir)\makeappx.exe</MakeAppxExe>
      <SignToolExe>$(WindowsKitBinDir)\signtool.exe</SignToolExe>
    </PropertyGroup>

    <MakeDir Directories="$(PackagesOutputDir)" />

    <!-- Validate makeappx is reachable -->
    <Error Condition="!Exists('$(MakeAppxExe)')"
           Text="makeappx.exe not found at '$(MakeAppxExe)'. Install the Windows 10 SDK." />

    <!-- Stage only the files that belong in the MSIX into a clean temp directory -->
    <PropertyGroup>
      <_MsixStagingDir>$(MSBuildThisFileDirectory)obj\MsixStaging\</_MsixStagingDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_MsixStagingDir)" />
    <MakeDir Directories="$(_MsixStagingDir)" />
    <MakeDir Directories="$(_MsixStagingDir)Assets" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)AppxManifest.xml" DestinationFolder="$(_MsixStagingDir)" />
    <ItemGroup>
      <_AssetFiles Include="$(MSBuildThisFileDirectory)Assets\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetFiles)" DestinationFolder="$(_MsixStagingDir)Assets\" />

    <!-- Test-only publisher override used by the SignPath test certificate in CI. -->
    <Exec Condition="'$(IdentityPackagePublisherOverride)' != '' and Exists('$(_DmExePath)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)PatchMsixVersion.ps1&quot; -ExePath &quot;$(_DmExePath)&quot; -ManifestPath &quot;$(_MsixStagingDir)AppxManifest.xml&quot; -Publisher &quot;$(IdentityPackagePublisherOverride)&quot;"
          ConsoleToMsBuild="true" />

    <!-- Pack the sparse MSIX from the clean staging directory -->
    <Exec Command="&quot;$(MakeAppxExe)&quot; pack /o /d &quot;$(_MsixStagingDir.TrimEnd('\'))&quot; /p &quot;$(IdentityMsixPath)&quot; /nv"
          ConsoleToMsBuild="true" />
    <Message Importance="high" Text="MSIX packed: $(IdentityMsixPath)" />

    <!-- Sign only when a certificate PFX is configured -->
    <PropertyGroup>
      <_SigningConfigured Condition="'$(SigningCertificatePfx)' != '' and Exists('$(SigningCertificatePfx)')">true</_SigningConfigured>
      <_TimestampArg Condition="'$(SigningTimestampUrl)' != ''">/tr $(SigningTimestampUrl) /td sha256</_TimestampArg>
    </PropertyGroup>

    <Exec Condition="'$(_SigningConfigured)' == 'true'"
          Command="&quot;$(SignToolExe)&quot; sign /fd SHA256 /f &quot;$(SigningCertificatePfx)&quot; /p &quot;$(SigningCertificatePassword)&quot; $(_TimestampArg) &quot;$(IdentityMsixPath)&quot;"
          ConsoleToMsBuild="true"
          EchoOff="true" />
    <Message Condition="'$(_SigningConfigured)' == 'true'" Importance="high"
             Text="MSIX signed with: $(SigningCertificatePfx)" />
    <Warning Condition="'$(_SigningConfigured)' != 'true'"
             Text="SigningConfig.props not found or PFX missing — MSIX was NOT signed. Copy SigningConfig.props.example to SigningConfig.props and configure your certificate." />
  </Target>

  <!-- Clean removes the output MSIX -->
  <Target Name="CleanMsix" AfterTargets="Clean">
    <Delete Files="$(IdentityMsixPath)" ContinueOnError="true" />
    <Message Importance="normal" Text="Cleaned: $(IdentityMsixPath)" />
  </Target>

</Project>
