<Project Sdk="WixToolset.Sdk/7.0.0">
  <!-- Optional, local-only signing settings created by prepare_displaymagician.ps1. -->
  <Import Project="..\SigningConfig.props" Condition="Exists('..\SigningConfig.props')" />
  <Import Project="RuntimeConfig.props"
        Condition="Exists('RuntimeConfig.props')" />
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>DisplayMagicianSetup</OutputName>
    <AcceptEula>wix7</AcceptEula>
    <DmPackageDir>$(MSBuildThisFileDirectory)..\DisplayMagicianPackage\bin\$(Platform)\$(Configuration)\en-US\</DmPackageDir>
    <DefineConstants>
      DmPackageDir=$(DmPackageDir);
      DotNetDesktopRuntimeVersion=$(DotNetDesktopRuntimeVersion);
      DotNetDesktopRuntimeFilename=$(DotNetDesktopRuntimeFilename);
      AspNetCoreRuntimeVersion=$(AspNetCoreRuntimeVersion);
      AspNetCoreRuntimeFilename=$(AspNetCoreRuntimeFilename)
    </DefineConstants>
    <!-- Suppress ICE validation to avoid WIX1105 warning when not running as admin -->
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="DisplayMagician.ico" />
    <Content Include="DisplayMagicianTheme.xml" />
    <Content Include="EULA_en-us.rtf" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ensure DisplayMagicianPackage MSI is built before this Bundle -->
    <!-- CI reuses the SignPath-signed MSI rather than rebuilding it. -->
    <ProjectReference Include="..\DisplayMagicianPackage\DisplayMagicianPackage.wixproj" Condition="'$(UseExistingMsiPackage)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning"
                    Version="3.9.50"
                    PrivateAssets="all" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="7.0.0" />
  </ItemGroup>
  <Target Name="ValidateRuntimeConfig" BeforeTargets="Build">
    <Error
        Condition="'$(DotNetDesktopRuntimeVersion)' == ''"
        Text="The .NET Desktop Runtime configuration is missing. Run prepare_displaymagician.ps1 first." />

    <Error
        Condition="'$(DotNetDesktopRuntimeFilename)' == ''"
        Text="The .NET Desktop Runtime filename is missing. Run prepare_displaymagician.ps1 first." />

    <Error
        Condition="'$(AspNetCoreRuntimeVersion)' == ''"
        Text="The ASP.NET Core Runtime configuration is missing. Run prepare_displaymagician.ps1 first." />

    <Error
        Condition="'$(AspNetCoreRuntimeFilename)' == ''"
        Text="The ASP.NET Core Runtime filename is missing. Run prepare_displaymagician.ps1 first." />
  </Target>
  <!-- Added as workaround for FireGiant HeatWave bug #73 https://github.com/firegiant/HeatWaveSupport/issues/73 -->
  <Target Name="CollectSuggestedVisualStudioComponentIds" />

  <Target Name="CreateVersionedBundle"
        AfterTargets="Build"
        DependsOnTargets="GetBuildVersion">

    <PropertyGroup>
      <VersionedBundlePath>
        $(TargetDir)DisplayMagicianSetup_v$(BuildVersion).exe
      </VersionedBundlePath>
    </PropertyGroup>

    <Copy
        SourceFiles="$(TargetPath)"
        DestinationFiles="$(VersionedBundlePath)"
        SkipUnchangedFiles="false" />

    <Delete Files="$(TargetPath)" />

    <Message
      Importance="High"
      Text="" />

    <Message
        Importance="High"
        Text="=== Renaming generated DisplayMagician setup bundle ===" />

    <Message
        Importance="High"
        Text="$(VersionedBundlePath)" />

    <Message
        Importance="High"
        Text="" />

  </Target>

  <!-- Sign the final versioned EXE after it has been renamed. CI deliberately
       leaves this disabled and signs this same file through SignPath. -->
  <Target Name="SignLocalVersionedBundle" AfterTargets="CreateVersionedBundle">
    <PropertyGroup>
      <_LocalSigningConfigured Condition="'$(SigningCertificatePfx)' != '' and Exists('$(SigningCertificatePfx)')">true</_LocalSigningConfigured>
      <_LocalSigningTimestampArgument Condition="'$(SigningTimestampUrl)' != ''">/tr $(SigningTimestampUrl) /td sha256</_LocalSigningTimestampArgument>
      <_WindowsKitRoot>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', null, RegistryView.Registry32, RegistryView.Default))</_WindowsKitRoot>
      <_VersionedBundlePathToSign>$(VersionedBundlePath.Trim())</_VersionedBundlePathToSign>
    </PropertyGroup>

    <Exec Condition="'$(_LocalSigningConfigured)' == 'true'"
          Command="powershell -NoProfile -Command &quot;(Get-ChildItem '$(_WindowsKitRoot)bin' -Filter '10.*' -Directory | Sort-Object Name -Descending | Select-Object -First 1 -ExpandProperty FullName)&quot;"
          ConsoleToMsBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_WindowsKitVersionDirectory" />
    </Exec>
    <PropertyGroup>
      <_LocalSignToolExe>$(_WindowsKitVersionDirectory.Trim())\x64\signtool.exe</_LocalSignToolExe>
    </PropertyGroup>

    <Error Condition="'$(_LocalSigningConfigured)' == 'true' and !Exists('$(_LocalSignToolExe)')"
           Text="signtool.exe was not found. Install the Windows SDK before building a locally signed bundle." />
    <Exec Condition="'$(_LocalSigningConfigured)' == 'true'"
          Command="&quot;$(_LocalSignToolExe)&quot; sign /fd SHA256 /f &quot;$(SigningCertificatePfx)&quot; /p &quot;$(SigningCertificatePassword)&quot; $(_LocalSigningTimestampArgument) &quot;$(_VersionedBundlePathToSign)&quot;"
          ConsoleToMsBuild="true"
          EchoOff="true" />
    <Message Condition="'$(_LocalSigningConfigured)' == 'true'"
             Importance="high"
             Text="Versioned bundle signed with the configured local development certificate." />
    <Warning Condition="'$(SigningCertificatePfx)' != '' and !Exists('$(SigningCertificatePfx)')"
             Text="The configured local signing PFX was not found, so the versioned bundle was not signed." />
  </Target>
</Project>
