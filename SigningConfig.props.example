<!--
  Copy this file to SigningConfig.props in the same directory and fill in your values.
  SigningConfig.props is gitignored — never commit it.

  To generate a self-signed certificate and this configuration for development use:
    .\prepare_displaymagician.ps1
  Or set the path/password below for an existing PFX.
-->
<Project>
  <PropertyGroup>
    <!-- Full path to the PFX code-signing certificate -->
    <SigningCertificatePfx>C:\path\to\DisplayMagicianCodeSigning.pfx</SigningCertificatePfx>

    <!-- Password for the PFX (leave empty if none) -->
    <SigningCertificatePassword>YourPasswordHere</SigningCertificatePassword>

    <!--
      Timestamp server URL (optional but recommended for production).
      Leave empty to skip timestamping (fine for local dev).
      Example: http://timestamp.digicert.com
    -->
    <SigningTimestampUrl></SigningTimestampUrl>
  </PropertyGroup>
</Project>
