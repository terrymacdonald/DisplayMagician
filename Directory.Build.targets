<Project>
  <Target Name="VerifySupportLogTargets"
          BeforeTargets="CoreCompile"
          Condition="'$(SkipSupportLogTargetVerification)' != 'true' and ('$(MSBuildProjectName)' == 'DisplayMagician' or '$(MSBuildProjectName)' == 'DisplayMagicianConsole' or '$(MSBuildProjectName)' == 'DisplayMagician.UserAgent' or '$(MSBuildProjectName)' == 'DisplayMagician.ControlService' or '$(MSBuildProjectName)' == 'DisplayMagician.SessionLauncher')">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)VerifySupportLogTargets.ps1&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -ProjectName &quot;$(MSBuildProjectName)&quot;" />
  </Target>
</Project>
