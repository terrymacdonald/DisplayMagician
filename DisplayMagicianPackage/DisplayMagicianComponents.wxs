<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
	<Fragment>
		<!--
			ProgramData is deliberately split into a machine-only branch and a per-SID
			branch. The installer grants the LocalService Control Service access to the
			machine branch and to create per-SID roots; StoragePaths then grants each
			interactive user Modify access only to their own SID root.
		-->
		<ComponentGroup Id="DisplayMagicianProgramDataComponents" Directory="DisplayMagicianProgramDataFolder">
			<Component Id="DisplayMagicianProgramDataRootComponent" Guid="{C5E1A210-1E8C-4C6A-888D-B360C6D67527}">
				<CreateFolder>
					<PermissionEx Sddl="D:PAI(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)" />
				</CreateFolder>
			</Component>
			<Component Id="DisplayMagicianMachineDataComponent" Guid="{F1DEF9AA-C98E-4651-9003-D29599035F5C}" Directory="DisplayMagicianMachineDataFolder">
				<CreateFolder>
					<PermissionEx Sddl="D:PAI(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)(A;OICI;GA;;;LS)" />
				</CreateFolder>
			</Component>
			<Component Id="DisplayMagicianMachineLogsComponent" Guid="{D51483FD-8081-4703-B6C0-0EF75AB6FDA2}" Directory="DisplayMagicianMachineLogsFolder">
				<CreateFolder />
			</Component>
			<Component Id="DisplayMagicianMachineBackupsComponent" Guid="{D1639CC6-CC33-4394-9D99-4C13BD58ACA7}" Directory="DisplayMagicianMachineBackupsFolder">
				<CreateFolder />
			</Component>
			<Component Id="DisplayMagicianMachineDiagnosticsComponent" Guid="{FC967F83-39A0-4B8C-9EEB-D7C3CA5C25F2}" Directory="DisplayMagicianMachineDiagnosticsFolder">
				<CreateFolder />
			</Component>
			<Component Id="DisplayMagicianUsersDataComponent" Guid="{E275B377-2857-4618-A375-F7C0D5745C58}" Directory="DisplayMagicianUsersDataFolder">
				<CreateFolder>
					<PermissionEx Sddl="D:PAI(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)(A;OICI;GA;;;LS)" />
				</CreateFolder>
			</Component>
		</ComponentGroup>

		<ComponentGroup Id="DisplayMagicianComponents" Directory="INSTALLFOLDER">
			<Component>
				<RegistryKey Root="HKLM" Key="Software\DisplayMagician" ForceDeleteOnUninstall="yes"/>
				<RegistryValue Root="HKLM" Key="Software\DisplayMagician" Name="InstalledVersion" Value="!(bind.fileVersion.DisplayMagicianExe)"/>
				<RegistryValue Root="HKLM" Key="Software\DisplayMagician" Name="InstalledDate" Value="[Date]"/>
				<RegistryValue Root="HKLM" Key="Software\DisplayMagician" Name="InstalledDir" Value="[INSTALLFOLDER]"/>
				<!-- MsiLogging populates this standard property with the current transaction log path. -->
				<RegistryValue Root="HKLM" Key="Software\DisplayMagician" Name="LastInstallerLogPath" Value="[MsiLogFileLocation]"/>
			</Component>
			<Component>
				<File Source="$(var.DmPublishDir)DisplayMagician.exe" Id="DisplayMagicianExe" KeyPath="yes" />
			</Component>

			<!-- Install every framework-dependent runtime file published with the application. -->
			<Files Include="$(var.DmPublishDir)**">
				<Exclude Files="$(var.DmPublishDir)DisplayMagician.exe" />
			</Files>

			<!-- Sparse MSIX identity package — installed alongside the app and registered via custom action -->
			<Component Id="IdentityMsixComponent">
				<File Id="IdentityMsixFile"
					  Source="Packages\DisplayMagicianIdentityPkg.msix"
					  KeyPath="yes" />
			</Component>

			<Component>
				<File Id="RegisterSparsePackageScript"
					  Source="RegisterSparsePackage.ps1" />
			</Component>

			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\LockScreenLogo.scale-200.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Square150x150Logo.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Square150x150Logo.scale-200.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Square44x44Logo.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Square44x44Logo.scale-200.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Square44x44Logo.targetsize-44_altform-unplated.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\StoreLogo.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Wide310x150Logo.png" />
			</Component>
			<Component Directory="IdentityAssetsFolder">
				<File Source="..\DisplayMagicianIdentityPkg\Assets\Wide310x150Logo.scale-200.png" />
			</Component>

			<Component Id="StartMenuShortcutComponent" Directory="DisplayMagicianStartMenuFolder">
				<Shortcut Id="DisplayMagicianStartMenuShortcut"
						  Name="DisplayMagician"
						  Description="Configure display profiles, audio profiles, and game shortcuts"
						  Target="[#DisplayMagicianExe]"
						  WorkingDirectory="INSTALLFOLDER"
						  Icon="dm.exe"
						  Advertise="no">
					<!-- Match Program.AppTaskbarUserModelId so pinning and launching keep one taskbar group. -->
					<ShortcutProperty Id="DisplayMagicianTaskbarIdentity" Key="System.AppUserModel.ID" Value="LittleBitBig.DisplayMagician.Desktop" />
				</Shortcut>
				<RegistryValue Root="HKLM"
						   Key="Software\DisplayMagician"
						   Name="StartMenuShortcut"
						   Type="integer"
						   Value="1"
						   KeyPath="yes" />
			</Component>
		</ComponentGroup>

		<ComponentGroup Id="DisplayMagicianControlServiceComponents" Directory="ControlServiceFolder">
			<Component Id="ControlServiceComponent">
				<File Id="ControlServiceExe" Source="$(var.DmControlServicePublishDir)DisplayMagician.ControlService.exe" KeyPath="yes" />
				<ServiceInstall Id="InstallControlService"
							Name="DisplayMagicianControlService"
							DisplayName="DisplayMagician Control Service"
							Description="Coordinates DisplayMagician machine operations and user agents."
							Start="auto"
							Type="ownProcess"
							ErrorControl="normal"
							Vital="yes">
					<util:ServiceConfig FirstFailureActionType="restart"
										SecondFailureActionType="restart"
										ThirdFailureActionType="restart"
										RestartServiceDelayInSeconds="60"
										ResetPeriodInDays="1" />
				</ServiceInstall>
				<ServiceControl Id="ControlControlService"
							Name="DisplayMagicianControlService"
							Start="install"
							Stop="both"
							Remove="uninstall"
							Wait="yes" />
			</Component>
			<Files Include="$(var.DmControlServicePublishDir)**">
				<Exclude Files="$(var.DmControlServicePublishDir)DisplayMagician.ControlService.exe" />
			</Files>
		</ComponentGroup>

		<ComponentGroup Id="DisplayMagicianSessionLauncherComponents" Directory="SessionLauncherFolder">
			<Component Id="SessionLauncherComponent">
				<File Id="SessionLauncherExe" Source="$(var.DmSessionLauncherPublishDir)DisplayMagician.SessionLauncher.exe" KeyPath="yes" />
				<ServiceInstall Id="InstallSessionLauncher"
							Name="DisplayMagicianSessionLauncher"
							DisplayName="DisplayMagician Session Launcher"
							Description="Starts the DisplayMagician user agent in the active user session."
							Start="demand"
							Type="ownProcess"
							ErrorControl="normal"
							Vital="yes">
					<util:ServiceConfig FirstFailureActionType="restart"
										SecondFailureActionType="restart"
										ThirdFailureActionType="restart"
										RestartServiceDelayInSeconds="60"
										ResetPeriodInDays="1" />
				</ServiceInstall>
				<ServiceControl Id="ControlSessionLauncher"
							Name="DisplayMagicianSessionLauncher"
							Stop="both"
							Remove="uninstall"
							Wait="yes" />
			</Component>
			<Files Include="$(var.DmSessionLauncherPublishDir)**">
				<Exclude Files="$(var.DmSessionLauncherPublishDir)DisplayMagician.SessionLauncher.exe" />
			</Files>
		</ComponentGroup>

		<ComponentGroup Id="DisplayMagicianGatewayComponents" Directory="GatewayFolder">
			<Component Id="GatewayComponent">
				<File Id="GatewayExe" Source="$(var.DmGatewayPublishDir)DisplayMagician.Gateway.exe" KeyPath="yes" />
				<ServiceInstall Id="InstallGateway"
							Name="DisplayMagicianGateway"
							DisplayName="DisplayMagician Gateway"
							Description="Provides secure paired-device access to DisplayMagician."
							Account="NT AUTHORITY\LocalService"
							Start="auto"
							Type="ownProcess"
							ErrorControl="normal"
							Vital="yes">
					<util:ServiceConfig FirstFailureActionType="restart"
										SecondFailureActionType="restart"
										ThirdFailureActionType="restart"
										RestartServiceDelayInSeconds="60"
										ResetPeriodInDays="1" />
				</ServiceInstall>
				<ServiceControl Id="ControlGateway"
							Name="DisplayMagicianGateway"
							Start="install"
							Stop="both"
							Remove="uninstall"
							Wait="yes" />
				<util:FirewallException Id="GatewayFirewallException"
									Name="DisplayMagician Gateway"
									Description="Allows paired DisplayMagician devices to connect to the Gateway."
									Port="22846"
									Protocol="tcp"
									Scope="any" />
			</Component>
			<Files Include="$(var.DmGatewayPublishDir)**">
				<Exclude Files="$(var.DmGatewayPublishDir)DisplayMagician.Gateway.exe" />
			</Files>
		</ComponentGroup>

		<ComponentGroup Id="DisplayMagicianUserAgentComponents" Directory="UserAgentFolder">
			<Component>
				<File Id="UserAgentExe" Source="$(var.DmUserAgentPublishDir)DisplayMagician.UserAgent.exe" KeyPath="yes" />
			</Component>
			<Files Include="$(var.DmUserAgentPublishDir)**">
				<Exclude Files="$(var.DmUserAgentPublishDir)DisplayMagician.UserAgent.exe" />
			</Files>
		</ComponentGroup>

		<ComponentGroup Id="DisplayMagicianConsoleComponents" Directory="INSTALLFOLDER">
			<Component>
				<!-- Add the install location to the system PATH so that users can use the console from anywhere on the PC. -->
				<Environment Name="PATH" System="yes" Value="[INSTALLFOLDER]" Action="set" Part="last"/>
				<RegistryValue Root="HKLM"
							   Key="Software\DisplayMagician"
							   Name="ConsolePath"
							   Value="[INSTALLFOLDER]"
							   KeyPath="yes" />
			</Component>

			<!-- All shared console dependencies are already installed with the main application. -->
			<Component>
				<File Source="$(var.DmConsolePublishDir)DisplayMagicianConsole.exe" />
			</Component>
			<Component>
				<File Source="$(var.DmConsolePublishDir)DisplayMagicianConsole.dll" />
			</Component>
			<Component>
				<File Source="$(var.DmConsolePublishDir)DisplayMagicianConsole.deps.json" />
			</Component>
			<Component>
				<File Source="$(var.DmConsolePublishDir)DisplayMagicianConsole.runtimeconfig.json" />
			</Component>
			<Component>
				<File Source="$(var.DmConsolePublishDir)DisplayMagicianConsole.pdb" />
			</Component>
		</ComponentGroup>

		<Icon Id="dm.exe" SourceFile="DisplayMagician.ico" />
	</Fragment>
</Wix>
